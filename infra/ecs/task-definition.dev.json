{
  "family": "kimply-dev",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::827152325060:role/kimply-dev-ecs-execution",
  "taskRoleArn": "arn:aws:iam::827152325060:role/kimply-dev-ecs-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "${IMAGE}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ROOT_URL", "value": "https://dev.kimply.online" },
        { "name": "PORT", "value": "3000" },
        { "name": "METEOR_POLLING_INTERVAL_MS", "value": "3000" },
        { "name": "GOOGLE_CLIENT_ID", "value": "" }
      ],
      "secrets": [
        {
          "name": "MONGO_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:827152325060:secret:kimply/dev/mongo-url-uxNVjn"
        }
      ],
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "stopTimeout": 30,
      "healthCheck": {
        "command": [
          "CMD",
          "node",
          "-e",
          "require('http').get('http://127.0.0.1:3000/health/live',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/kimply-dev",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
