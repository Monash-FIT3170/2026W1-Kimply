# Kimply reverse proxy.
#
# This file is a TEMPLATE. The official nginx image's entrypoint runs envsubst over
# it at container start and writes the result to /etc/nginx/conf.d/kimply.conf.
#
# NGINX_ENVSUBST_FILTER in docker-compose.prod.yml restricts substitution to
# ${DOMAIN} alone. Without that filter envsubst would also eat nginx's own
# runtime variables ($host, $remote_addr, $http_upgrade, ...) and destroy the config.

# Maps the client's Upgrade header to the correct Connection value. WebSocket
# requests get "upgrade"; ordinary requests get "close" rather than a stray
# "Connection: upgrade" that some proxies mishandle.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream kimply_app {
    # Docker Compose service name. The app container publishes no ports to the
    # host, so this network path is the only way to reach it.
    server app:3000;
    keepalive 32;
}

server {
    # default_server so that requests with an unmatched Host header - a bare hit on
    # the Elastic IP, a scanner, stale DNS - are handled here rather than falling
    # through to whatever else happens to be defined first.
    listen 80 default_server;
    listen [::]:80 default_server;
    # Both names, so certificate renewal works for either.
    server_name ${DOMAIN} www.${DOMAIN};

    # Must be served over plain HTTP and must NOT be redirected, or certificate
    # renewal fails.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect straight to the canonical apex rather than https://$host, so a www
    # visitor takes one hop instead of two (http://www -> https://www -> https://apex).
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www over HTTPS: reached by direct https://www links or an HSTS-primed browser.
# Needs the certificate to cover www, or the client sees a TLS warning before it
# ever gets this redirect.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Enable only once real certificates are confirmed working. Turning this on
    # before successful issuance locks browsers out of the site.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Deliberately NO Content-Security-Policy. The app uses inline style={{...}}
    # objects throughout and loads fonts from fonts.googleapis.com, so a strict
    # CSP breaks it. Adding one later requires at minimum:
    #   style-src 'self' 'unsafe-inline' fonts.googleapis.com;
    #   font-src 'self' fonts.gstatic.com;
    #   connect-src 'self' wss://${DOMAIN};

    # nginx's own liveness, answered without touching the app. Distinguishes
    # "nginx is down" from "the app is down".
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Everything is proxied to Meteor, including unknown paths. Meteor's connect
    # handler serves index.html for them, which is what makes BrowserRouter deep
    # links such as /play/ABCDE and /play/join?code=... work on a hard load.
    # Do NOT add a static root with try_files here; that is what breaks them.
    location / {
        proxy_pass http://kimply_app;
        proxy_http_version 1.1;

        # WebSocket upgrade for DDP. If these are missing the client silently
        # falls back to SockJS long-polling, which still works but multiplies
        # connection count and latency at 100 players.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # DDP connections are long-lived and mostly idle between rounds. The
        # 60s default would drop players sitting in a lobby.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_connect_timeout 10s;
    }

    # SockJS fallback transports stream their response. Buffering makes them
    # stall, so it has to be off on this path specifically.
    location /sockjs/ {
        proxy_pass http://kimply_app;
        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
