# Template for /opt/kimply/.env on the production EC2 instance.
#
# PLACEHOLDER VALUES ONLY. Never commit a filled-in copy - .env is gitignored,
# and the real file must be created on the instance itself:
#
#   umask 077 && cp .env.production.example .env && nano .env
#   stat -c '%a %U:%G' .env      # must print: 600 root:root
#
# Consumed by:  docker compose -f docker-compose.prod.yml --env-file .env up -d

# --- Application image -------------------------------------------------------
# Fully-qualified ECR reference including the exact 40-character commit SHA.
# deploy/deploy.sh rewrites this line on every deploy; it doubles as the record
# of what is currently running and as the rollback target.
APP_IMAGE=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/kimply:0000000000000000000000000000000000000000

# --- Public identity ---------------------------------------------------------
# Bare hostname, no scheme. Used for the nginx server_name and the certificate path.
DOMAIN=kimply.example.com

# Must be the public HTTPS origin. Meteor puts this in __meteor_runtime_config__,
# so a wrong value here breaks the client's DDP endpoint.
ROOT_URL=https://kimply.example.com

# Email Let's Encrypt uses for expiry warnings. Consumed by deploy/init-letsencrypt.sh.
LETSENCRYPT_EMAIL=you@example.com

# --- Database ----------------------------------------------------------------
# MongoDB Atlas, using the dedicated application user (readWrite on `kimply` only).
#
#   - mongodb+srv:// gives TLS by default; no extra flag needed.
#   - The database name MUST be in the path or every collection lands in `test`.
#   - maxPoolSize caps connections so one app instance does not consume a large
#     share of the Atlas free tier's 500-connection allowance.
#   - Do NOT add directConnection=true; it disables replica-set discovery and
#     breaks +srv.
MONGO_URL=mongodb+srv://kimply_app:REPLACE_WITH_GENERATED_PASSWORD@kimply-mongodb.rom2saq.mongodb.net/kimply?retryWrites=true&w=majority&maxPoolSize=20&appName=Kimply

# Generate the password with:  openssl rand -base64 32

# --- ECR (not secret; an account id and a repository name) -------------------
AWS_REGION=ap-southeast-2
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com
ECR_REPOSITORY=kimply

# -----------------------------------------------------------------------------
# LOCAL VALIDATION (Phase 3, before any AWS resource exists)
#
# The production config can be exercised end to end on a laptop by overriding:
#
#   APP_IMAGE=kimply:test
#   DOMAIN=localhost
#   ROOT_URL=https://localhost
#   MONGO_URL=mongodb://host.docker.internal:27017/kimply-prodtest
#
# The MONGO_URL above reaches the development MongoDB container, which
# docker-compose.yml publishes on host port 27017. Run deploy/init-letsencrypt.sh
# with --self-signed to generate a placeholder certificate so nginx will start.
