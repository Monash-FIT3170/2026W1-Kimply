# Copy this to .env on the DigitalOcean Droplet before running docker compose.
# Do not commit the real .env file.

MONGO_USER=kimply
MONGO_PASSWORD=replace-with-a-long-random-password

# Use the public URL players will open.
# Examples:
# ROOT_URL=http://203.0.113.10:3000
# ROOT_URL=https://kimply.example.com
ROOT_URL=http://your-droplet-ip:3000

METEOR_SETTINGS={}
